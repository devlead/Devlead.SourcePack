<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon/devlead.sourcepack.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>sourcepack;msbuild;nuget;source</PackageTags>
    <PackageDescription>Opinionated MSBuild package for authoring source NuGet packages using standard SDK pack.</PackageDescription>
    <RepositoryUrl>https://github.com/devlead/Devlead.SourcePack.git</RepositoryUrl>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Devlead.SourcePack.Tasks\Devlead.SourcePack.Tasks.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
  </ItemGroup>

  <Target Name="_BuildSourcePackTasks"
          BeforeTargets="_AddSourcePackTasksToPackage">
    <MSBuild Projects="..\Devlead.SourcePack.Tasks\Devlead.SourcePack.Tasks.csproj"
             Targets="Restore;Build"
             Properties="Configuration=$(Configuration);BuildProjectReferences=false;NoBuild=false;GeneratePackageOnBuild=false" />
  </Target>

  <Target Name="_AddSourcePackTasksToPackage" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <None Include="..\Devlead.SourcePack.Tasks\bin\$(Configuration)\netstandard2.0\Devlead.SourcePack.Tasks.dll"
            Pack="true"
            PackagePath="tools\netstandard2.0\"
            Visible="false" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None Include="build\**\*" Pack="true" PackagePath="build\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="buildCrossTargeting\**\*" Pack="true" PackagePath="buildCrossTargeting\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\..\icon\devlead.sourcepack.png" Pack="true" PackagePath="icon\devlead.sourcepack.png" />
    <None Include="..\..\icon\LICENSE.md" Pack="true" PackagePath="icon\LICENSE.md" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
